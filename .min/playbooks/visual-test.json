{
  "name": "visual-test",
  "description": "Exercises every browser action on the bundled visual test page, including drag, upload, and download.",
  "version": 1,
  "steps": [
    { "action": "tabs", "operation": "list" },
    { "action": "navigate", "url": "min://app/pages/playbookTest/index.html" },
    { "action": "wait", "load": true, "timeout": 15000 },
    { "action": "reload" },
    { "action": "wait", "load": true, "timeout": 15000 },
    { "action": "snapshot" },
    { "action": "screenshot" },
    { "action": "click", "selector": "#btn-click" },
    { "action": "assert", "selector": "#row-click.pass", "timeout": 4000 },
    { "action": "dblclick", "selector": "#btn-dblclick" },
    { "action": "assert", "selector": "#row-dblclick.pass", "timeout": 4000 },
    { "action": "rightclick", "selector": "#btn-rightclick" },
    { "action": "assert", "selector": "#row-rightclick.pass", "timeout": 4000 },
    { "action": "hover", "selector": "#btn-hover" },
    { "action": "assert", "selector": "#row-hover.pass", "timeout": 4000 },
    { "action": "type", "selector": "#input-type", "text": "min-playbook" },
    { "action": "assert", "selector": "#row-type.pass", "timeout": 4000 },
    { "action": "press", "selector": "#input-type", "key": "Enter" },
    { "action": "assert", "selector": "#row-press.pass", "timeout": 4000 },
    { "action": "select", "selector": "#select-color", "value": "green" },
    { "action": "assert", "selector": "#row-select.pass", "timeout": 4000 },
    { "action": "click", "selector": "#check-box" },
    { "action": "assert", "selector": "#row-check.pass", "timeout": 4000 },
    { "action": "scroll", "selector": "#scroll-panel", "direction": "bottom" },
    { "action": "assert", "selector": "#row-scroll.pass", "timeout": 4000 },
    { "action": "drag", "selector": "#drag-src", "targetSelector": "#drop-zone" },
    { "action": "assert", "selector": "#row-drag.pass", "timeout": 4000 },
    { "action": "upload", "selector": "#file-input", "path": "min://app/pages/playbookTest/upload-sample.txt" },
    { "action": "assert", "selector": "#row-upload.pass", "timeout": 4000 },
    { "action": "download", "selector": "#download-link", "timeout": 25000 },
    { "action": "assert", "selector": "#row-download.pass", "timeout": 4000 },
    { "action": "click", "selector": "#shadow-btn" },
    { "action": "assert", "selector": "#row-shadow.pass", "timeout": 4000 },
    { "action": "wait", "selector": "#iframe-btn", "timeout": 8000 },
    { "action": "click", "selector": "#iframe-btn" },
    { "action": "assert", "selector": "#row-iframe.pass", "timeout": 4000 },
    { "action": "click", "selector": "#btn-alert", "acceptDialog": true, "timeout": 8000 },
    { "action": "assert", "selector": "#row-dialog.pass", "timeout": 4000 },
    { "action": "screenshot" },
    { "action": "assert", "selector": "#score.pass-all", "timeout": 4000 }
  ]
}
