+
+function makeAppAuthGrantUrl(grantPath: string): string | null {
+  try {
+    const rawPath = String(grantPath || "").trim();
+    // Figma has emitted both "/app_auth/…" and "//app_auth/…" over time.
+    // Treat those as path references; otherwise URL() interprets the latter
+    // as a different hostname.
+    const input = /^https?:\/\//i.test(rawPath) ? rawPath : `/${rawPath.replace(/^\/+/, "")}`;
+    const url = new URL(input, `${Const.HOMEPAGE}/`);
+    if (
+      !/^https?:$/i.test(url.protocol) ||
+      !/(^|\.)figma\.com$/i.test(url.hostname) ||
+      !/^\/app_auth\/[^/]+\/grant/.test(url.pathname)
+    ) {
+      return null;
+    }
+    if (!url.searchParams.has("desktop_protocol")) {
+      url.searchParams.set("desktop_protocol", "figma");
+    }
+    return url.toString();
+  } catch {
+    return null;
+  }
+}
+
+function openGrantInMin(url: string): Promise<void> {
+  const payload = JSON.stringify({ url });
+  return new Promise((resolve, reject) => {
+    const req = http.request(
+      {
+        host: "127.0.0.1",
+        port: MIN_BRIDGE_PORT,
+        path: "/auth/open",
+        method: "POST",
+        headers: {
+          "Content-Type": "application/json",
+          "X-Min-Figma-Bridge": MIN_BRIDGE_TOKEN,
+          "Content-Length": Buffer.byteLength(payload),
+        },
+        timeout: 2500,
+      },
+      (res) => {
+        res.resume();
+        if (res.statusCode && res.statusCode >= 200 && res.statusCode < 300) {
+          resolve();
+          return;
+        }
+        reject(new Error(`min auth open ${res.statusCode}`));
+      },
+    );
+    req.on("error", reject);
+    req.on("timeout", () => {
+      req.destroy();
+      reject(new Error("min auth open timeout"));
+    });
+    req.write(payload);
+    req.end();
+  });
+}
